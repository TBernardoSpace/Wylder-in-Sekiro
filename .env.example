# =====================================================================
#  News-to-Token Signal Radar — configuración (copiar a .env)
# =====================================================================

# --- General ---------------------------------------------------------
DEMO_MODE=false            # true = simulación offline (o `python -m radar --demo`)
DB_PATH=radar.db
HOST=127.0.0.1            # 0.0.0.0 solo si querés el dashboard en la LAN (pon INGEST_TOKEN)
PORT=8000
LOG_LEVEL=INFO

# --- LLM: Claude Haiku (extracción de entidades + juez de matches) ----
ANTHROPIC_API_KEY=
LLM_ENABLED=true
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low             # low = mínima latencia
LLM_TIMEOUT_S=12
LLM_MAX_CONCURRENCY=4

# --- Noticias ----------------------------------------------------------
NEWS_POLL_SECONDS=10
NEWS_MAX_AGE_MINUTES=60    # ignora noticias más viejas (evita backfill al arrancar)
CRYPTOPANIC_TOKEN=         # https://cryptopanic.com/developers/api/
CRYPTOPANIC_URL=https://cryptopanic.com/api/developer/v2/posts/
NEWSAPI_KEY=               # https://newsapi.org
NEWSAPI_QUERY=             # vacío = top-headlines del país; ej: trump OR musk OR viral
NEWSAPI_COUNTRY=us
GDELT_ENABLED=false
GDELT_QUERY=(trump OR musk OR "breaking") sourcelang:english
# RSS separados por coma. Para cuentas de X usa un puente RSS (RSSHub self-hosted, rss.app, nitter):
# RSS_FEEDS=https://rsshub.example.com/twitter/user/WatcherGuru,https://rsshub.example.com/twitter/user/DeItaone
RSS_FEEDS=
# Feed push por WebSocket (ej. Tree of Alpha). Cabeceras y mensajes de suscripción en JSON:
WS_NEWS_URL=
WS_NEWS_HEADERS={}
WS_NEWS_SUBSCRIBE=[]

# --- Token Scanner (fomo.family) ---------------------------------------
# Vías activas, combinables:
#   d = flujo on-chain de la app FOMO en Solana (RECOMENDADA: lo que compran los usuarios de FOMO en vivo)
#   c = on-chain genérico (DexScreener + pump.fun)
#   a = endpoints internos de fomo (bloqueados por Cloudflare fuera del navegador -> usa el userscript)
#   b = wrapper de terceros
FOMO_MODES=d,c
FOMO_POLL_SECONDS=5
# Formato confirmado: https://fomo.family/tokens/solana/<mint>
FOMO_TOKEN_URL_TEMPLATE=https://fomo.family/tokens/{chain}/{address}
TOKEN_MAX_AGE_MINUTES=240
CHAINS=solana,base

# Vía A — endpoints internos (rellenar con lo que veas en DevTools o con tools/capture_fomo_network.py)
FOMO_A_URL=
FOMO_A_METHOD=GET
FOMO_A_BODY=               # JSON para POST/GraphQL: {"operationName":"...","variables":{...},"query":"..."}
FOMO_A_HEADERS={}          # {"authorization":"Bearer ...","x-app-version":"..."}
FOMO_A_ITEMS_PATH=         # ruta a la lista, ej: data.tokens  (vacío = autodetección)
FOMO_A_FIELD_MAP={}        # {"liquidity_usd":"stats.liquidity","holder_count":"holders.total"}
FOMO_A_DEFAULT_CHAIN=solana
FOMO_A_WS_URL=
FOMO_A_WS_SUBSCRIBE=[]
FOMO_A_PLAYWRIGHT=false    # true = navegador headless que intercepta XHR/WS (Cloudflare, cookies)
FOMO_A_PLAYWRIGHT_PAGE=https://fomo.family/
FOMO_A_PLAYWRIGHT_URL_REGEX=api|graphql|tokens|trending
CHROMIUM_PATH=             # opcional: Chromium ya instalado en lugar de `playwright install`

# Vía A en navegador — userscript tools/fomo_bridge.user.js -> POST /api/ingest/fomo
INGEST_TOKEN=              # secreto compartido con el userscript (recomendado)

# Vía D — flujo on-chain de FOMO (co-firmante AgmLJBMDCqWynYnQiPCuj9ewsNNsBJXyzoUhD9LJzN51)
# RPC de Solana (Helius, QuickNode, Chainstack, Triton... el público api.mainnet-beta se queda corto)
SOLANA_RPC_WSS=wss://mainnet.helius-rpc.com/?api-key=TU_KEY
SOLANA_RPC_HTTPS=https://mainnet.helius-rpc.com/?api-key=TU_KEY
FOMO_FLOW_TRANSPORT=logs   # logs = cualquier RPC (1 getTransaction por trade) | blocks = blockSubscribe
FOMO_FLOW_WINDOW_S=300
FOMO_FLOW_MIN_BUYERS=2     # traders FOMO distintos para empezar a seguir un token
FOMO_FLOW_MAX_RPS=8        # tope de getTransaction/seg (ajústalo a tu plan de RPC)

# Vía B — wrappers de terceros (URL exacta según la doc del proveedor; {category} se reemplaza)
FOMO_B_URL=
FOMO_B_API_KEY=
FOMO_B_API_KEY_HEADER=x-api-key   # o Authorization (Bearer) o query:api_key
FOMO_B_CATEGORY=Memes
FOMO_B_ITEMS_PATH=
FOMO_B_FIELD_MAP={}
FOMO_B_DEFAULT_CHAIN=solana

# Vía C — on-chain (DexScreener + pump.fun)
FOMO_C_SOURCES=dexscreener,pumpfun
PUMPFUN_URL=https://frontend-api-v3.pump.fun/coins?offset=0&limit=50&sort=created_timestamp&order=DESC&includeNsfw=false
# Stream de pump.fun en tiempo real (cada lanzamiento + metadata: descripción, twitter, web):
#   pumpportal = gratis (wss://pumpportal.fun/api/data), solo lanzamientos
#   rpc        = eventos on-chain del programa de pump.fun vía SOLANA_RPC_WSS: lanzamientos + cada
#                compra/venta (market cap, volumen 5m, compras/ventas en vivo). Mucho tráfico.
#   off
PUMPFUN_STREAM=pumpportal
PUMPPORTAL_WSS=wss://pumpportal.fun/api/data
IPFS_GATEWAY=https://ipfs.io/ipfs/
PUMPFUN_COIN_URL=https://frontend-api-v3.pump.fun/coins/{mint}   # respaldo para la metadata (vacío = no usar)
SOL_PRICE_USD=0            # 0 = se toma de DexScreener cada minuto
REQUIRE_ON_FOMO=false      # true = solo alertar tokens vistos en fomo (Vía A/B/D)

# --- Matcher -------------------------------------------------------------
NEWS_WINDOW_HOURS=6
FUZZY_PREFILTER=55         # pares por debajo no llegan al LLM
MATCH_THRESHOLD=80         # score final para considerar match
LLM_WEIGHT=0.7             # score = 0.7*LLM + 0.3*fuzzy
MAX_NEWS_PER_JUDGE=8
RECHECK_SECONDS=15         # re-evaluación de candidatos en "watch"
RECHECK_MINUTES=30

# --- Narrativas emergentes (encuentra "la noticia" por la ola de tokens, sin titular) ---------
NARRATIVE_ENABLED=true
NARRATIVE_WINDOW_MIN=10
NARRATIVE_MIN_TOKENS=4     # tokens nuevos con el mismo término en la ventana
NARRATIVE_SPIKE_RATIO=3    # x veces lo normal para ese término (evita "trump", "pepe"...)
NARRATIVE_BASELINE_HOURS=6
NARRATIVE_WARMUP_MIN=15    # minutos de observación antes de emitir
NARRATIVE_COOLDOWN_MIN=60

# --- Filtros de seguridad ------------------------------------------------
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_5M=1000
REQUIRE_VOLUME_GROWTH=true
VOLUME_GROWTH_MIN_PCT=0
HONEYPOT_POLICY=warn       # strict = bloquea si no se puede verificar la venta | warn | off
MIN_FOMO_BUYERS_5M=0       # >0 = exigir N traders de FOMO comprando en los últimos 5 min (Vía D)
LEADER_SWITCH_RATIO=2.0    # otro token de la misma noticia re-alerta si tiene >= 2x la liquidez
ENRICH_WITH_DEXSCREENER=true

# --- Alertas -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
DISCORD_MENTION=@here
